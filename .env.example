# Copy to .env (git-ignored). Every setting has a safe local default.
REGLENS_ENV=local
REGLENS_LOG_LEVEL=INFO
# Free key: https://console.groq.com/keys (answers, obligations, gap judge)
REGLENS_GROQ_API_KEY=
# Shared secret between the API and the console's server-side proxy (compose default: local-dev-key)
# REGLENS_API_KEY=
# Optional: Langfuse tracing (https://cloud.langfuse.com free tier, or self-hosted)
REGLENS_LANGFUSE_PUBLIC_KEY=
REGLENS_LANGFUSE_SECRET_KEY=
REGLENS_LANGFUSE_HOST=https://cloud.langfuse.com
# Only needed when running outside docker compose
# REGLENS_DATABASE_URL=postgresql+psycopg://reglens:reglens-local@localhost:5432/reglens
# REGLENS_QDRANT_URL=http://localhost:6333
# REGLENS_REDIS_URL=redis://localhost:6379/0
